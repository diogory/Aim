local function GetRoot(char)
	if not char then return nil end

	local hum=char:FindFirstChildOfClass("Humanoid")
	local root=char:FindFirstChild("HumanoidRootPart")

	if hum and root and hum.Health>0 then
		return root
	end
end

local function GetHead(char)
	if not char then return nil end

	local head=char:FindFirstChild("Head")

	if head and head:IsA("BasePart") then
		return head
	end
end

local function FindNearest()
	local me=GetRoot(LP.Character)
	if not me then return nil end

	local best=nil
	local bestDist=AIM_RANGE

	for _,p in ipairs(Players:GetPlayers()) do
		if p~=LP then
			local root=GetRoot(p.Character)

			if root then
				local d=(root.Position-me.Position).Magnitude

				if d<=AIM_RANGE and d<bestDist then
					bestDist=d
					best=p
				end
			end
		end
	end

	return best
end

local function AimAt(player)
	local head=GetHead(player.Character)
	local camera=Workspace.CurrentCamera

	if not head or not camera then return end

	local goal=CFrame.lookAt(
		camera.CFrame.Position,
		head.Position
	)

	camera.CFrame=camera.CFrame:Lerp(
		goal,
		AIM_SMOOTH
	)
end

local function GetDistance(player)
	if not player then return nil end

	local a=GetRoot(LP.Character)
	local b=GetRoot(player.Character)

	if not a or not b then return nil end

	return (b.Position-a.Position).Magnitude
end

local function GetHighlight(player)
	if player==LP or not player.Character then
		return nil
	end

	local h=player.Character:FindFirstChild("D_Hitbox")

	if not h then
		h=Instance.new("Highlight")
		h.Name="D_Hitbox"
		h.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
		h.Parent=player.Character
	end

	h.Adornee=player.Character

	return h
end

local function UpdateHitbox(player)
	if player==LP then return end

	local root=GetRoot(player.Character)
	local h=GetHighlight(player)

	if not root or not h then return end

	if not HITBOX then
		h.Enabled=false
		return
	end

	h.Enabled=true
	h.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
	h.OutlineTransparency=0

	if player==Target then
		h.FillColor=Color3.fromRGB(150,0,0)
		h.OutlineColor=Color3.fromRGB(255,30,30)
		h.FillTransparency=.12
	else
		h.FillColor=Color3.fromRGB(0,80,25)
		h.OutlineColor=Color3.fromRGB(30,255,75)
		h.FillTransparency=.28
	end
end

local function UpdateHitboxes()
	local count=0

	for _,p in ipairs(Players:GetPlayers()) do
		if p~=LP then
			if count<MAX_HITBOX then
				UpdateHitbox(p)
				count+=1
			else
				local c=p.Character
				local h=c and c:FindFirstChild("D_Hitbox")

				if h then
					h.Enabled=false
				end
			end
		end
	end
end

local AimTimer=0
local HitTimer=0
local InfoTimer=0

RunService.Heartbeat:Connect(function(dt)
	AimTimer+=dt
	HitTimer+=dt
	InfoTimer+=dt

	if AimTimer>=.016 then
		AimTimer=0

		if AIM then
			Target=FindNearest()

			if Target then
				AimAt(Target)
			end
		else
			Target=nil
		end
	end

	if InfoTimer>=.05 then
		InfoTimer=0

		if Target then
			local d=GetDistance(Target)

			if d then
				TargetText.Text=
					"TARGET: "..Target.Name..
					" | "..math.floor(d).." STUDS"
			else
				TargetText.Text="TARGET: NONE | 0 STUDS"
			end
		else
			TargetText.Text="TARGET: NONE | 0 STUDS"
		end
	end

	if HitTimer>=.2 then
		HitTimer=0
		UpdateHitboxes()
	end
end)

