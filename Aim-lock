local Saved={
	parts={},
	particles={},
	trails={},
	beams={},
	smoke={},
	fire={},
	effects={}
}

local LightSaved=nil
local Switching=false

local function SaveLighting()
	if LightSaved then return end

	LightSaved={
		shadow=Lighting.GlobalShadows,
		diffuse=Lighting.EnvironmentDiffuseScale,
		specular=Lighting.EnvironmentSpecularScale
	}
end

local function SavePart(o)
	if not Saved.parts[o] then
		Saved.parts[o]={
			shadow=o.CastShadow,
			material=o.Material
		}
	end
end

local function SaveParticle(o)
	if not Saved.particles[o] then
		Saved.particles[o]={
			rate=o.Rate,
			life=o.Lifetime
		}
	end
end

local function SaveTrail(o)
	if Saved.trails[o]==nil then
		Saved.trails[o]=o.Lifetime
	end
end

local function SaveBeam(o)
	if Saved.beams[o]==nil then
		Saved.beams[o]=o.Segments
	end
end

local function SaveSmoke(o)
	if Saved.smoke[o]==nil then
		Saved.smoke[o]=o.Opacity
	end
end

local function SaveFire(o)
	if not Saved.fire[o] then
		Saved.fire[o]={
			size=o.Size,
			heat=o.Heat
		}
	end
end

local function SaveEffect(o)
	if Saved.effects[o]==nil then
		Saved.effects[o]=o.Enabled
	end
end

local function ApplyGraphics(mode)
	SaveLighting()
	QUALITY=mode

	local pm,lm,tm,bm,sm,fm,d,s

	if mode=="MEDIUM" then
		pm,lm,tm,bm,sm,fm,d,s=.7,.8,.2,4,.12,4,.7,.7
	elseif mode=="HIGH" then
		pm,lm,tm,bm,sm,fm,d,s=.5,.6,.1,2,.06,2,.4,.4
	else
		pm,lm,tm,bm,sm,fm,d,s=.3,.4,.05,1,.03,1,.2,.2
	end

	Lighting.GlobalShadows=false
	Lighting.EnvironmentDiffuseScale=d
	Lighting.EnvironmentSpecularScale=s

	for _,o in ipairs(Workspace:GetDescendants()) do
		if o:IsA("BasePart") then
			SavePart(o)
			o.CastShadow=false

			if mode~="MEDIUM" then
				o.Material=Enum.Material.SmoothPlastic
			else
				o.Material=Saved.parts[o].material
			end

		elseif o:IsA("ParticleEmitter") then
			SaveParticle(o)

			local v=Saved.particles[o]

			o.Rate=v.rate*pm
			o.Lifetime=NumberRange.new(
				v.life.Min*lm,
				v.life.Max*lm
			)

		elseif o:IsA("Trail") then
			SaveTrail(o)
			o.Lifetime=math.min(Saved.trails[o],tm)

		elseif o:IsA("Beam") then
			SaveBeam(o)
			o.Segments=math.min(Saved.beams[o],bm)

		elseif o:IsA("Smoke") then
			SaveSmoke(o)
			o.Opacity=math.min(Saved.smoke[o],sm)

		elseif o:IsA("Fire") then
			SaveFire(o)
			o.Size=math.min(Saved.fire[o].size,fm)
			o.Heat=math.min(
				Saved.fire[o].heat,
				mode=="MAX" and 1 or 5
			)

		elseif o:IsA("PostEffect") then
			SaveEffect(o)

			if mode~="MEDIUM" then
				o.Enabled=false
			end
		end
	end

	for _,o in ipairs(Lighting:GetChildren()) do
		if o:IsA("PostEffect") then
			SaveEffect(o)

			if mode~="MEDIUM" then
				o.Enabled=false
			end
		end
	end

	UpdateUI()
end

local function RestoreGraphics()
	if LightSaved then
		Lighting.GlobalShadows=LightSaved.shadow
		Lighting.EnvironmentDiffuseScale=LightSaved.diffuse
		Lighting.EnvironmentSpecularScale=LightSaved.specular
	end

	for o,v in pairs(Saved.parts) do
		if o.Parent then
			o.CastShadow=v.shadow
			o.Material=v.material
		end
	end

	for o,v in pairs(Saved.particles) do
		if o.Parent then
			o.Rate=v.rate
			o.Lifetime=v.life
		end
	end

	for o,v in pairs(Saved.trails) do
		if o.Parent then
			o.Lifetime=v
		end
	end

	for o,v in pairs(Saved.beams) do
		if o.Parent then
			o.Segments=v
		end
	end

	for o,v in pairs(Saved.smoke) do
		if o.Parent then
			o.Opacity=v
		end
	end

	for o,v in pairs(Saved.fire) do
		if o.Parent then
			o.Size=v.size
			o.Heat=v.heat
		end
	end

	for o,v in pairs(Saved.effects) do
		if o.Parent then
			o.Enabled=v
		end
	end
end

local function SetFixLag(state)
	if Switching or FIXLAG==state then return end

	Switching=true
	FIXLAG=state

	task.spawn(function()
		if FIXLAG then
			ApplyGraphics(QUALITY)
		else
			RestoreGraphics()
			UpdateUI()
		end

		task.wait()
		Switching=false
	end)
end

